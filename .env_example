# Django
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Django database connection
DATABASE_NAME=lms_db
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# PostgreSQL container initialization
POSTGRES_DB=lms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Stripe
STRIPE_API_KEY=replace-with-a-stripe-test-key
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/
STRIPE_CANCEL_URL=http://127.0.0.1:8000/

# Celery and Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Email
EMAIL_HOST_USER=replace-with-an-email-address
EMAIL_HOST_PASSWORD=replace-with-an-email-application-password
